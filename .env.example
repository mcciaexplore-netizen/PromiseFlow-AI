# Defaults are a local-only synthetic demonstration.
PROMISEFLOW_MODE=demo
PROMISEFLOW_DB=data/promiseflow.db
# Leave empty for local SQLite operation without Supabase.
PROMISEFLOW_DATABASE_URL=
# Optional Supabase PostgreSQL connection; keep the real value only in .env or server secrets.
# Use Connect > Session pooler for an IPv4 backend. URL-encode the database password.
# PROMISEFLOW_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# PROMISEFLOW_DB_SCHEMA=promiseflow
# If required, use the Supabase CA certificate downloaded from your project:
# PROMISEFLOW_DB_SSLROOTCERT=/absolute/path/to/prod-supabase.cer
PROMISEFLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8017,http://localhost:8017
# For production: set mode=production, a NEW database and a unique bootstrap
# admin password of 16+ characters. Use HTTPS and your exact allowed origin.
# PROMISEFLOW_ADMIN_PASSWORD=<set-through-your-secret-manager>
